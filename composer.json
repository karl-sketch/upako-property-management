{
    "name": "karl-sketch/upako-property-management",
    "description": "UpaKo - Complete Web-Based Property Management System for Landlords and Tenants",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Karl",
            "email": "kharlbagaan0@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "files": [
            "config/config.php",
            "config/database.php",
            "includes/auth.php",
            "includes/helpers.php"
        ],
        "psr-4": {
            "UpaKo\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 .",
        "lint-fix": "phpcbf --standard=PSR12 .",
        "analyze": "phpstan analyze"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "property-management",
        "landlord",
        "tenant",
        "lease",
        "billing",
        "payments",
        "maintenance"
    ],
    "homepage": "https://github.com/karl-sketch/upako-property-management",
    "support": {
        "issues": "https://github.com/karl-sketch/upako-property-management/issues",
        "source": "https://github.com/karl-sketch/upako-property-management"
    }
}
